# MongoDB Atlas stores enquiries and authentication sessions only.
MONGODB_URI=
MONGODB_DB_NAME=atelier

# Cloudinary credentials are server-only. Never prefix the API secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login. Prefer a scrypt hash; generate one with `npm run admin:password`.
ADMIN_AUTH_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD_HASH=
# Optional for local bootstrap only; remove it after generating the hash.
INITIAL_ADMIN_PASSWORD=

# Owner-only enquiry notification through Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@atelierwallstory.com
BREVO_RECEIVER_EMAIL=atelierwallstory@gmail.com
# Resend fallback / webhook (optional).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=
ENQUIRY_NOTIFICATION_TO_EMAIL=

# Site URLs, signed cron email retry, and optional media.
APP_URL=
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
NEXT_PUBLIC_HERO_POSTER_URL=
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_WALL_VISUALIZER_URL=
