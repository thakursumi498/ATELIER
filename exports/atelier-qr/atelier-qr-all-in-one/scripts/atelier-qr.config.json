{
  "destinationUrl": "https://www.atelierwallstory.com/",
  "outputDirectory": "exports/atelier-qr",
  "logoPath": "auto",
  "logoWidthRatio": 0.2,
  "quietZoneModules": 4,
  "outputResolutions": [1024, 2048, 4096],
  "formats": ["png", "svg", "pdf"],
  "pdfPageSizeInches": 6,
  "variants": [
    {
      "id": "variant-01-classic",
      "label": "Variant 01 — Classic",
      "foreground": "$brand.charcoal",
      "background": "#FFFFFF",
      "caption": null
    },
    {
      "id": "variant-02-brand-theme",
      "label": "Variant 02 — Brand Theme",
      "foreground": "$brand.crimson",
      "background": "$brand.offWhite",
      "caption": null
    },
    {
      "id": "variant-03-print-edition",
      "label": "Variant 03 — Print Edition",
      "foreground": "$brand.charcoal",
      "background": "$brand.offWhite",
      "caption": "SCAN TO EXPLORE"
    }
  ]
}
